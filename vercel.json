{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/analytics/route.ts": {
      "maxDuration": 5
    },
    "src/app/api/artwork/route.ts": {
      "maxDuration": 10
    },
    "src/app/api/health/route.ts": {
      "maxDuration": 5
    },
    "src/app/api/notifications/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/search/route.ts": {
      "maxDuration": 5
    },
    "src/app/api/search/facets/route.ts": {
      "maxDuration": 5
    },
    "src/app/api/search/index/route.ts": {
      "maxDuration": 5
    },
    "src/app/api/sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/sync/quality/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/sync/repair/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/vote/route.ts": {
      "maxDuration": 5
    }
  },
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "11 6 * * *"
    },
    {
      "path": "/api/sync/quality",
      "schedule": "23 7 * * *"
    },
    {
      "path": "/api/sync/repair",
      "schedule": "47 8 * * *"
    },
    {
      "path": "/api/notifications",
      "schedule": "37 8 * * *"
    }
  ]
}
